# ==============================================================================
# RummerLab Room 12 Husbandry System - Environment Variables
# ==============================================================================

# 1. Google Sheets API Configuration (Google Cloud Service Account)
# ------------------------------------------------------------------------------
# Create a Google Cloud Project with the Google Sheets API enabled.
# Create a Service Account, generate a JSON Key, and share your Google Sheet
# with the Service Account email address as an 'Editor'.
GOOGLE_SERVICE_ACCOUNT_EMAIL="husbandry-sync@your-project-id.iam.gserviceaccount.com"

# The private key from your service account JSON file.
# Note: On Vercel, paste the entire private key including BEGIN and END markers.
# Replace newlines with \n if entering as a single-line string.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# The ID of the Google Sheet (found in the URL):
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID="1a2b3c4d5e6f7g8h9i0j_your_google_sheet_id_here"

# 2. Public URLs (Optional)
# ------------------------------------------------------------------------------
# Optional HTTPS Google Sheets document URL; defaults to GOOGLE_SHEET_ID in preview mode.
# Google sharing permissions must grant lab members Viewer access for read-only access.
PUBLIC_GOOGLE_SHEET_VIEW_URL="https://docs.google.com/spreadsheets/d/your-sheet-id/edit?usp=sharing"

# App Deployment Domain
PUBLIC_APP_DOMAIN="husbandry.rummerlab.com"

# Optional restricted health diagnostics; use a random secret of at least 32 characters.
# GET /api/health/diagnostics uses Authorization: Bearer <token>.
HEALTH_DIAGNOSTICS_TOKEN=""

# Vercel SDK rules husbandry-submit / husbandry-login must be provisioned first.
# Off until rules are configured; use log for observation, then enforce to activate.
RATE_LIMIT_MODE="off"

# Shared lab HTTP Basic access. Activate only after sharing credentials and enforcing rate rules.
LAB_ACCESS_ENABLED="false"
# Set a random password of at least 24 characters outside version control.
LAB_ACCESS_USERNAME="lab"
LAB_ACCESS_PASSWORD=""

# Enable only AFTER the reviewed four-column workbook migration.
GOOGLE_SHEET_METADATA_ENABLED="false"

# Optional restricted request log (IP, location, browser details per submission).
# Must be a SEPARATE workbook shared only with lab administrators, never the master sheet.
# Set up with scripts/setup-request-log.mjs; see docs/request-log.md. Empty = off.
GOOGLE_REQUEST_LOG_SHEET_ID=""
